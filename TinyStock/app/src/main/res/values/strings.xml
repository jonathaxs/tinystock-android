<?xml version="1.0" encoding="utf-8"?>
<!-- Textos so do Android. Os textos vindos do iOS ficam em strings_ios.xml (gerado); uma chave definida
     aqui substitui a de la, para adaptar o texto ao Android. -->
<resources>
    <string name="app_name" translatable="false">TinyStock</string>

    <!-- Telas ainda nao portadas do iOS. Saem quando cada uma chegar. -->
    <string name="coming_soon_title">Coming soon</string>
    <string name="coming_soon_message">This screen is still being brought over from the iPhone version.</string>

    <!-- Backup v1 (anterior as lojas): so o iOS restaura. -->
    <string name="backup_error_legacy">This backup is from an older version of TinyStock. Open it on the iPhone, export it again and import the new file.</string>

    <!-- Sem iCloud no Android: os dados ficam no aparelho e o backup e um arquivo. -->
    <string name="welcome_about_icloud_desc">Your data stays on this device, with backups you save wherever you like.</string>

    <!-- Acessibilidade dos botoes redondos - / + -->
    <string name="a11y_decrease">Decrease</string>
    <string name="a11y_increase">Increase</string>
    <string name="a11y_delete">Delete</string>

    <!-- Exportar prazos do pedido: no Android vai para o app de agenda do aparelho. -->
    <string name="calendar_export_section">Phone calendar</string>
    <string name="calendar_export_unavailable">No calendar app found to add this event.</string>
</resources>
